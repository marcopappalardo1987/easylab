# macOS
.DS_Store

# Ambiente / segreti (mai versionati — vedi docs/Architettura/Setup Repository e Ambienti.md)
.env
.env.*
!.env.example

# Laravel (predisposizione S1 — l'installer completerà questo file)
/vendor
/node_modules
/public/build
/public/hot
/public/storage
/storage/*.key
/storage/pail
/bootstrap/cache/*.php

# IDE / editor
/.idea
/.vscode
/.nova
/.zed
/.cursor
/.codex
*.swp
.phpactor.json
_ide_helper.php

# Test / cache
/.phpunit.cache
.phpunit.result.cache
/auth.json

# Playwright MCP (snapshot e screenshot di sessione: materiale di verifica,
# non di progetto). La configurazione del server sta invece in `.mcp.json`.
/.playwright-mcp

# Misc
Homestead.json
Homestead.yaml
Thumbs.db

# Log
*.log

# Config MCP locale (Playwright): strumento di sviluppo, non di progetto
.mcp.json

# Stato di esecuzione del restyling (lucchetti, segnali, scatti) — non è sorgente
/.restyling/

.ai/
/public/guide
