APP_NAME="Easy Lab"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://easylab.test

# Account Developer creato dal seeder (valori reali solo in .env locale / Forge)
DEVELOPER_EMAIL=
DEVELOPER_PASSWORD=

APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=easylab
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Disco dei documenti: `local` in sviluppo, `s3` per il bucket B2 (ADR-025/026)
DOCUMENTI_DISK_DRIVER=local

# Stripe / Laravel Cashier — ADR-002 (rapporto A: EasyLab incassa) e ADR-032
# (il Billable è l'Account, non l'Ente). Chiavi in modalità TEST in locale e su
# staging, LIVE solo in produzione (Setup Ambienti §2.1 e §3).
# I tre segreti restano vuoti nel repo: si compilano a mano.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
# Finestra di tolleranza (secondi) sulla firma del webhook: il default di Cashier.
STRIPE_WEBHOOK_TOLERANCE=300

# Price id del piano SaaS (config/easylab.php -> piani.catalogo.saas).
# Senza, `easylab:abbona --piano=saas` si ferma nominando questa variabile.
# ⚠️ Su Laravel Cloud deve esistere già in BUILD: `php artisan optimize` gira
# lì e cuoce la config, quindi una variabile aggiunta dopo resta invisibile.
STRIPE_PRICE_SAAS=

# Publishable key esposta al browser da Stripe.js/Elements: stesso valore di STRIPE_KEY.
VITE_STRIPE_KEY="${STRIPE_KEY}"

# Valuta e formattazione degli importi. `it_IT` richiede ext-intl (presente in locale).
CASHIER_CURRENCY=eur
CASHIER_CURRENCY_LOCALE=it_IT
# Prefisso delle rotte di Cashier — il webhook diventa POST /stripe/webhook,
# da escludere dalla verifica CSRF e da registrare nella dashboard Stripe.
CASHIER_PATH=stripe
# Canale su cui Cashier logga le eccezioni Stripe; vuoto = nessun log.
CASHIER_LOGGER=stack
# Formato carta delle fatture PDF generate da Cashier (default `letter`, US).
CASHIER_PAPER=a4

# Superadmin di piattaforma (SuperadminSeeder). Senza queste due variabili il
# seeder non crea nulla: nessuna password di default per un account di piattaforma.
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Error tracker interno (config/easylab.php -> errori). Gli errori PHP finiscono
# a database perché su Laravel Cloud `laravel.log` sta su un disco effimero e
# per-replica, azzerato a ogni deploy.
# ⚠️ La config è cachata in build (`php artisan optimize`): spegnere il tracker
# richiede un REDEPLOY, non basta cambiare la variabile.
ERRORI_ABILITATO=true
# Casella che riceve l'alert alla prima occorrenza di un errore nuovo (e alle
# regressioni). ⚠️ Lasciarla vuota NON spegne gli alert: si ripiega su
# DEVELOPER_EMAIL, letta dalla config e mai dal database. Per il silenzio vanno
# svuotate entrambe — ed è l'unico modo di zittire la posta senza spegnere il
# tracker.
# ⚠️ Canale senza gate e senza registro di audit: la pagina degli errori è del
# solo Developer, questa email la legge chiunque abbia la casella. Per questo
# l'email porta solo classe, file:riga, conteggio e il link — mai il messaggio,
# lo stack trace, l'input o chi ha subito l'errore (ADR-017, Privacy T8).
ERRORI_ALERT_EMAIL=

# Self-signup pubblico (config/easylab.php -> registrazione, ADR-012 + ADR-032).
# ⛔ Default `false`, ed è il verso giusto: `/registrati` è l'unica superficie
# insieme PUBBLICA, non autenticata e in SCRITTURA del progetto, e aprirla è una
# decisione commerciale — non l'effetto collaterale di un deploy. Con `false`
# GET e POST rispondono 404 (non 403: un 403 dichiarerebbe che la pagina c'è).
# ⚠️ Spegne solo l'INGRESSO: chi ha già pagato completa comunque, o avremmo
# incassato senza consegnare.
# ⚠️ La config è cachata in build (`php artisan optimize`): cambiarla richiede
# un REDEPLOY.
# ⚠️ Non basta da sola: senza STRIPE_PRICE_SAAS il modulo dice «registrazioni
# chiuse» invece di regalare un account su un piano gratuito.
REGISTRAZIONE_APERTA=false
